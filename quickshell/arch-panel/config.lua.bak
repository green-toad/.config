-- ===========================================================================
--  Конфиг панели: только ЧТО показывать и в каком порядке.
--  Размеры и расположение внутри дропдаунов заданы в QML.
--
--  Сохрани файл - панель обновится сама (или: qs ipc call panel reload).
--  Ошибка в файле не ломает панель: остаётся последний рабочий конфиг.
--  Убери строку/имя из списка - виджет пропадёт, добавь - появится.
-- ===========================================================================

return {

  -- ------------------------------------------------------------------ БАР
  -- Доступные виджеты:
  --   logo, wifi, bluetooth, audio   иконки (открывают одноимённые дропдауны:
  --                                  logo -> system)
  --   workspaces, tray, clock, battery
  --
  -- left и right видны только когда панель развёрнута. center виден всегда:
  -- из него состоит свёрнутая таблетка.
  bar = {
    left   = { "logo", "wifi", "bluetooth", "audio" },
    center = { "workspaces" },
    right  = { "tray" },
  },

  -- ------------------------------------------------------------- ДРОПДАУНЫ
  -- Что показывать внутри. Пустой список = дропдаун отключён.
  dropdowns = {
    -- cpu, ram, battery, power, reboot, update, image
    -- (расположение в системном меню фиксированное, можно только
    --  включать/выключать части)
    system    = { "cpu", "ram", "battery", "power", "reboot", "update", "image" },

    wifi      = { "wifi" },
    bluetooth = { "bluetooth" },

    -- volume, player  (порядок фиксированный: громкость сверху, плеер снизу)
    audio     = { "volume", "player" },
  },
}
